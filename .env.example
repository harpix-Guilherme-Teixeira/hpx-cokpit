# Copie para .env.local e preencha. NUNCA comite valor real.
JIRA_BASE_URL=https://harpix.atlassian.net
JIRA_EMAIL=conta-de-servico@harpix.com.br
JIRA_API_TOKEN=
JIRA_CLOUD_ID=<id do site, obrigatorio quando o token e Bearer>

# Supabase, area da gestora.
# A chave ANON e publica por natureza: ela vai no bundle do navegador e
# qualquer visitante consegue ler. Quem protege o dado e a RLS, nao o segredo
# dela. A SERVICE_ROLE ignora RLS e NAO e usada por esta aplicacao: nao coloque
# aqui, nem no .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
